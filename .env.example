# Partner broker tracked link
NEXT_PUBLIC_BROKER_AFFILIATE_URL=

# Waitlist storage (Supabase). Leave unset to log masked emails only.
# Server-side only: never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Address shown on the Privacy Policy for access/deletion requests
NEXT_PUBLIC_PRIVACY_EMAIL=

# Canonical site URL (used for absolute OG/Twitter image links)
NEXT_PUBLIC_SITE_URL=https://alphamintai.com
